# Security configuration
# In production (NODE_ENV=production), JWT_SECRET is strictly required and cannot be a default.
# ALLOW_DEMO_AUTH: defaults to true in development, must be explicitly 'true' to allow demo authentication.
# In production (NODE_ENV=production), demo auth is permanently disabled by default unless ALLOW_DEMO_AUTH=true.
ALLOW_DEMO_AUTH=
